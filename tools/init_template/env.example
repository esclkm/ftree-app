# Пример ~/.config/ftree/env — пути этого Mac. Руками его обычно не пишут: его создаёт `rodo setup`.
# Порядок: ключ команды > переменная окружения > этот файл > ftree.toml > значение по умолчанию.
FTREE_ROOT={root}
# FTREE_APP=~/ftree-app            # где приложение, если оно не внутри дерева
# FTREE_SITE_OUT=~/Sites/tree      # куда собирать сайт
# ARCHIVES_LOCAL=~/archives        # сырьё архивов
